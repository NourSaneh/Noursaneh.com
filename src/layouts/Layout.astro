---
// Self-hosted fonts: no render-blocking request to Google Fonts.
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource/dm-mono/500.css";
import "@/styles/global.css";
import { site } from "@/data/site";
import { projects } from "@/data/projects";

interface Props {
  title?: string;
  description?: string;
}

const {
  // ~50–60 chars: name first (people search "Nour Saneh"), then role + location.
  title = `${site.name} · ${site.role} in the UAE`,
  // ~150–160 chars, written to be quoted by Google and AI answers.
  description = `${site.name} is a front-end & AI engineer in Sharjah, UAE, building React, TypeScript and LLM-powered web apps. See projects, skills and CV, or ask the AI chat.`,
} = Astro.props;
const siteUrl = Astro.site!.href;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.jpg", Astro.site);

// Structured data (schema.org @graph): who this page is about, so Google's
// knowledge graph and AI answer engines can identify "Nour Saneh" unambiguously.
const personId = `${siteUrl}#person`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: site.name,
      inLanguage: "en",
      publisher: { "@id": personId },
    },
    {
      "@type": "ProfilePage",
      "@id": `${canonical.href}#webpage`,
      url: canonical.href,
      name: title,
      description,
      inLanguage: "en",
      isPartOf: { "@id": `${siteUrl}#website` },
      mainEntity: { "@id": personId },
      primaryImageOfPage: ogImage.href,
      dateModified: new Date().toISOString().slice(0, 10),
    },
    {
      "@type": "Person",
      "@id": personId,
      name: site.name,
      givenName: "Nour",
      familyName: "Saneh",
      url: siteUrl,
      image: ogImage.href,
      jobTitle: site.role,
      description: site.tagline,
      address: { "@type": "PostalAddress", addressLocality: "Sharjah", addressCountry: "AE" },
      alumniOf: { "@type": "CollegeOrUniversity", name: "Lebanese International University" },
      knowsLanguage: ["Arabic", "English", "French"],
      knowsAbout: [
        "Front-end development",
        "React",
        "TypeScript",
        "Astro",
        "Tailwind CSS",
        "Supabase",
        "LLM applications",
        "Claude API",
        "Retrieval-augmented generation (RAG)",
        "Model Context Protocol (MCP)",
        "Technical SEO",
      ],
      hasCredential: {
        "@type": "EducationalOccupationalCredential",
        name: "Build with Claude (10 courses)",
        credentialCategory: "certificate",
        recognizedBy: { "@type": "Organization", name: "Anthropic Academy" },
      },
      sameAs: [site.links.github, site.links.linkedin],
    },
    {
      "@type": "ItemList",
      "@id": `${siteUrl}#projects`,
      name: `Projects by ${site.name}`,
      itemListElement: projects
        .filter((p) => !p.teaser)
        .map((p, i) => ({
          "@type": "ListItem",
          position: i + 1,
          item: {
            "@type": "CreativeWork",
            name: p.title,
            description: p.summary,
            creator: { "@id": personId },
            ...(p.url && { url: p.url }),
            ...(p.code && { codeRepository: p.code }),
          },
        })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#F6EFE0" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role} in the UAE`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content={site.name} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preload" as="image" href="/avatar.webp" fetchpriority="high" />
  </head>
  <body id="top">
    <a
      href="#projects"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-cream"
      >Skip to content</a
    >
    <slot />
  </body>
</html>
