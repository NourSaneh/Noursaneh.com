---
import { bio, skillGroups, timeline } from "@/data/about";
---

<section id="about" class="scroll-mt-4 border-t-[3px] border-ink bg-white px-4 pt-[88px] pb-24 sm:px-12">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-14">
    <div class="flex flex-wrap items-start gap-14">
      <div class="flex min-w-0 flex-[1_1_520px] flex-col gap-5">
        <span class="sticker -rotate-3 self-start bg-blush">03 — About</span>
        <h2 class="m-0 text-[clamp(48px,7vw,72px)] leading-none font-extrabold tracking-[-0.03em]">A bit about me.</h2>
        {bio.map((para) => <p class="m-0 text-lg leading-relaxed sm:text-xl">{para}</p>)}
      </div>

      <ol aria-label="Timeline" class="m-0 flex min-w-0 flex-[1_1_380px] list-none flex-col gap-4 p-0">
        {
          timeline.map((t) => (
            <li
              class:list={[
                "flex flex-col gap-1 rounded-2xl border-[2.5px] border-ink px-5 py-4.5",
                t.current ? "bg-sun shadow-[5px_5px_0_var(--color-cobalt)]" : "bg-cream shadow-[5px_5px_0_var(--color-ink)]",
                t.tilt && "-rotate-1",
              ]}
            >
              <span class="font-mono text-[13px]">{t.when}</span>
              <span class="text-xl font-extrabold">{t.title}</span>
              <span class="text-base">{t.where}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div id="skills" class="flex scroll-mt-8 flex-col gap-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h3 class="m-0 text-[40px] font-extrabold tracking-[-0.02em]">What I work with</h3>
        <p class="m-0 font-mono text-sm">★ = learning right now</p>
      </div>
      <div class="flex flex-wrap gap-6">
        {
          skillGroups.map((g) => (
            <div class:list={["card flex min-w-0 flex-[1_1_260px] flex-col gap-4 p-6 shadow-pop", g.className]}>
              <p class="m-0 text-2xl font-extrabold">{g.title}</p>
              <div class="flex flex-wrap gap-2">
                {g.items.map((item) => (
                  <span class="chip text-ink">{item}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
