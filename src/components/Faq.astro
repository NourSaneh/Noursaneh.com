---
import { faq } from "@/data/faq";
---

<section id="faq" class="scroll-mt-4 border-t-[3px] border-ink px-4 pt-[88px] pb-24 sm:px-12">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-10">
    <div class="flex flex-col gap-3">
      <span class="sticker -rotate-3 self-start bg-mint">04 — Quick answers</span>
      <h2 class="m-0 text-[clamp(48px,7vw,72px)] leading-none font-extrabold tracking-[-0.03em]">Quick answers.</h2>
      <p class="m-0 max-w-[560px] text-[19px] leading-normal">
        The questions recruiters and clients ask most. Want more? Ask my AI at the top of the page.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {
        faq.map((item) => (
          <article class="card flex flex-col gap-3 bg-white p-6 shadow-pop">
            <h3 class="m-0 text-2xl leading-tight font-extrabold">{item.q}</h3>
            <p class="m-0 text-base leading-relaxed">{item.a}</p>
            {item.link && (
              <a href={item.link.href} class="self-start font-extrabold">
                {item.link.label} →
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
