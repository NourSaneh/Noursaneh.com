---
interface Props {
  name: "music" | "gamepad" | "chat" | "food" | "download";
  size?: number;
  class?: string;
}
const { name, size = 16, class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  {
    name === "music" && (
      <>
        <path d="M9 18V5l11-2v13" />
        <circle cx="6" cy="18" r="3" />
        <circle cx="17" cy="16" r="3" />
      </>
    )
  }
  {
    name === "gamepad" && (
      <>
        <rect x="2" y="7" width="20" height="11" rx="5" />
        <path d="M7 11v3" />
        <path d="M5.5 12.5h3" />
        <circle cx="16" cy="11.5" r="0.6" />
        <circle cx="18" cy="13.5" r="0.6" />
      </>
    )
  }
  {name === "chat" && <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" />}
  {
    name === "food" && (
      <>
        <path d="M7 3v8" />
        <path d="M4 3v5a3 3 0 0 0 6 0V3" />
        <path d="M7 11v10" />
        <path d="M17 21V3c-2.5 1-4 3.5-4 7v4h4" />
      </>
    )
  }
  {
    name === "download" && (
      <>
        <path d="M12 4v11" />
        <path d="M7 10l5 5 5-5" />
        <path d="M5 20h14" />
      </>
    )
  }
</svg>
